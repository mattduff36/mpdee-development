# Resend contact email (server-only)
# Copy to .env.local and provide your own API key. Never commit secrets.
RESEND_API_KEY=
EMAIL_FROM="MPDEE Development Contact Form <sendme@mpdee.info>"

# Enquiries are delivered to admin@mpdee.co.uk; replies go to the visitor.
# Optional site URL for the message footer
NEXT_PUBLIC_SITE_URL=http://localhost:3000
